{
  "log": {
    "access": "none",
    "error": "none",
    "loglevel": "warning",
    "dnsLog": true,
    "maskAddress": ""
  },
  "inbounds": [
    {
      "tag": "in-socks",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true,
        "allowTransparent": false
      },
      "sniffing": {
        "enabled": false
      }
    }
  ],
  "outbounds": [
    {
      "tag": "out-proxy",
      "protocol": "vless",
      "settings": {
        "address": "<VPS_IPv4>",
        "port": 443,
        "id": "<Reality_UUID>",
        "flow": "xtls-rprx-vision",
        "encryption": "none"
      },
      "streamSettings": {
        "method": "raw",
        "security": "reality",
        "realitySettings": {
          "serverName": "<Reality_Site>",
          "fingerprint": "chrome",
          "password": "<Reality_publicKey>",
          "shortId": "<Reality_shortId>",
          "spiderX": "/",
          "show": false
        },
        "rawSettings": {
          "header": {
            "type": "none"
          }
        }
      }
    }
  ],
  "routing": {
    "rules": [
      {
        "inboundTag": "in-socks",
        "outboundTag": "out-proxy"
      }
    ]
  }
}
